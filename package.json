{
  "name": "nelego",
  "version": "1.0.0",
  "private": true,
  "description": "Karnataka tourism and heritage — a readable, standalone VS Code edition",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node backend/server.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/api.test.mjs",
    "format": "prettier --write frontend/src backend scripts tests docs *.json *.md *.ts .vscode"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "5.1.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
